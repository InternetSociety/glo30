# Copernicus Data Space Ecosystem S3 credentials
s3_access_key = replace-me
s3_secret_key = replace-me
s3_host_base = eodata.dataspace.copernicus.eu
s3_host_bucket = eodata.dataspace.copernicus.eu

# Generate a long random value for every deployment.
secret_key = replace-with-a-long-random-value
# Set this to true for every HTTPS production deployment.
cookie_secure = false

# Password-reset email. Leave disabled until the SMTP host and sender are configured.
smtp_enabled = false
smtp_host = mail.example.com
smtp_port = 25
smtp_from = no-reply@example.com

# Optional overrides
# database_url = sqlite+aiosqlite:////app/data/app.db
# copernicus_catalogue_url = https://catalogue.dataspace.copernicus.eu/odata/v1/Products
# glo30_s3_prefix = a/direct/s3/prefix/containing/geocells
# max_radius_m = 100000
# tile_cache_expiry_days = 30

# Output-shape tuning (defaults shown; see the detailed comments in app/config.py)
# dem_resolution_m = 30
# dem_resampling_method = bilinear
# geometry_vertices_per_sq_km = 100
# geometry_min_vertex_budget = 8
# geometry_max_vertex_budget = 10000
# geometry_polygon_connectivity = 8
# geometry_simplification_preserve_topology = false
# geometry_simplification_search_iterations = 40
# geometry_simplification_max_tolerance_radius_multiplier = 2

# Source-tile coverage only; this does not smooth the output geometry.
# coverage_boundary_sample_interval_degrees = 0.5
