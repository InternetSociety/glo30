services:
  app:
    build:
      context: .
    env_file:
      - .env
    environment:
      DATABASE_URL: sqlite+aiosqlite:////app/data/app.db
      TILE_CACHE_DIR: /app/data/tiles
    command: >-
      sh -c "alembic upgrade head && exec uvicorn app.main:app
      --host 0.0.0.0 --port 8000 --reload"
    ports:
      - "8000:8000"
    volumes:
      - .:/app
      - glo30-data:/app/data

volumes:
  glo30-data:
